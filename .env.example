# Copy values into your shell environment (or your hosting dashboard). All optional.
VORTEXA_ENV=development          # "production" disables /simulate-failure and the dev OTP hint
MOCK_TIME_SCALE=0.15             # 1.0 = mock models sleep for their full simulated latency
MAX_FALLBACK_ATTEMPTS=3
ELEVENLABS_API_KEY=              # enables ElevenLabs voice for "Listen to Explanation"
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SMTP_HOST=                       # enables real OTP emails (otherwise OTP is printed in the console)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
